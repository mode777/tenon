{
  "schemaVersion": 1,
  "id": "com.tenon.editor",
  "name": "Tenon",
  "version": "0.2.0",
  "description": "Schema-first entity and scene authoring for Tenon projects.",
  "publisher": {
    "name": "Tenon"
  },
  "engines": {
    "exo": ">=0.8.0"
  },
  "runtime": {
    "entry": "plugin.html"
  },
  "permissions": [
    "workspace:read",
    "workspace:write",
    "workspace:list",
    "events:subscribe"
  ],
  "contributes": {
    "fileEditors": [
      {
        "glob": "schemas/*.schema.json",
        "entry": "editor.html",
        "label": "Tenon Schema",
        "priority": 30,
        "rendering": "frame"
      }
    ],
    "panels": [
      {
        "id": "tenon.project",
        "title": "Tenon",
        "icon": "symbol-structure",
        "location": "primary",
        "entry": "views/project.html"
      }
    ],
    "commands": [
      {
        "id": "tenon.new-schema",
        "title": "New Schema",
        "category": "Tenon",
        "target": {
          "kind": "panel",
          "id": "tenon.project"
        },
        "menus": [
          "commandPalette"
        ]
      }
    ]
  }
}
